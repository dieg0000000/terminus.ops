#!/bin/bash
#
# Wrapper autour de ansible / ansible-playbook pour Terminus.
# Lance ./terminusible --help pour l'aide.

cd "$(dirname "$0")"; cd "$(/bin/pwd)"

usage () {
    cat <<EOF
Usage:

  ./terminusible [ -t sometag ] [OPTION]

Options:
  --check       Simulate, without changing anything
  --diff        Show the changes in files
  -m <module>   Ad-hoc mode: run a single module (e.g. -m ping all)
  --help        Display this help

Tags:
  -t setup      Setup the VM (packages, Docker, MOTD, SSH)
  -t build      Clone the code and copy the .env files
  -t run        Build the images and start the containers
  -t migrate    Copy the data from the old VM (never after the Cloudflare switch)

Without tag, runs setup + build + run.
EOF
}

inventory="-i inventory/prod.yml -i inventory/old.yml"

platform_check () {
    if ! test -f ansible-deps-cache/.versions 2>/dev/null; then
      curl https://raw.githubusercontent.com/epfl-si/ansible.suitcase/master/install.sh | \
            SUITCASE_ANSIBLE_VERSION="10.1.0" \
            SUITCASE_DIR=$PWD/ansible-deps-cache \
            SUITCASE_ANSIBLE_REQUIREMENTS=requirements.yml \
            SUITCASE_NO_EYAML=1 \
            bash -x
    fi
    export PATH="$PWD/ansible-deps-cache/bin:$PATH"
    export ANSIBLE_ROLES_PATH="$PWD/ansible-deps-cache/roles"
    export ANSIBLE_COLLECTIONS_PATH="$PWD/ansible-deps-cache"
}

mode=ansible-playbook

while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0 ;;
        -m) mode=ansible
            ansible_args+=("-m")
            shift ;;
        *)
            ansible_args+=("$1")
            shift ;;
    esac
done

# https://github.com/ansible/ansible/issues/32499, https://bugs.python.org/issue35219
case "$(uname -s)" in
    Darwin) export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES ;;
esac

set -e

platform_check
case "$mode" in
    ansible-playbook)
        ansible-playbook $inventory "${ansible_args[@]}" playbook.yml
        ;;
    ansible)
        ansible $inventory "${ansible_args[@]}"
        ;;
esac